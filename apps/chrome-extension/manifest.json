{
  "manifest_version": 3,
  "name": "OpenPet",
  "version": "0.1.0",
  "description": "A local-first pet status system for AI chat workflows.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://chat.deepseek.com/*", "https://*/*", "http://*/*"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ]
}
