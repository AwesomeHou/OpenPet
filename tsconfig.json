{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "chrome", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@openpet/shared/*": ["packages/shared/src/*"],
      "@openpet/state/*": ["packages/state/src/*"],
      "@openpet/pet-assets/*": ["packages/pet-assets/src/*"],
      "@openpet/adapters/*": ["packages/adapters/src/*"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "tests/**/*.ts", "scripts/**/*.mjs"]
}
